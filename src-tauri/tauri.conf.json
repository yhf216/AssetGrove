{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AssetGrove",
  "version": "0.5.6",
  "identifier": "com.assetgrove.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "AssetGrove", "width": 1060, "height": 720, "minWidth": 800, "minHeight": 560, "center": true, "resizable": true, "maximizable": true, "visible": false, "dragDropEnabled": false, "additionalBrowserArgs": "--no-proxy-server" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "languages": ["SimpChinese"], "startMenuFolder": "AssetGrove", "installerHooks": "./windows/hooks.nsh" } },
    "externalBin": ["binaries/assetgrove-backend"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
